# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/
env/

# Environment variables
.env
.env.local

# macOS system files
.DS_Store
.AppleDouble
.LSOverride
._*

# Jupyter Notebook checkpoints
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# Datasets (never commit raw images or generated split files)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/splits/*
!data/splits/.gitkeep

# Artifacts, weights, and large figures
artifacts/checkpoints/*
!artifacts/checkpoints/.gitkeep
artifacts/figures/*
!artifacts/figures/.gitkeep

# IDEs
.idea/
.vscode/
*.swp
*.swo
