# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
ENV/
env/

# Environment variables
.env
.env.local

# macOS system files
.DS_Store
**/.DS_Store
.AppleDouble
.LSOverride
._*

# Jupyter Notebook checkpoints
.ipynb_checkpoints
*/.ipynb_checkpoints/*

# Testing & Coverage
.pytest_cache/
.coverage
htmlcov/

# Datasets (keep split indices, documentation, and video samples; exclude massive raw image folders)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep

# Model checkpoints and visual artifacts are tracked via Git / Git LFS
!artifacts/checkpoints/**
!artifacts/figures/**
!artifacts/video/**

# IDEs
.idea/
.vscode/
*.swp
*.swo
