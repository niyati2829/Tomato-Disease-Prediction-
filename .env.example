# Environment Configuration Template
# Copy this file to '.env' before running any scripts:
#   cp .env.example .env
# Note: Never commit real credentials or secret keys to version control.

# Application Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# Experiment Random Seed
RANDOM_SEED=42

# Optional Local Directory Overrides
# DATA_DIR=data/raw
# ARTIFACTS_DIR=artifacts/checkpoints

# Streamlit App Configuration (for Phase 2)
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_ADDRESS=localhost
